#version 450 core

// Tile rasterization with cooperative shared-memory batching: each 16x16 workgroup
// fetches 256 sorted splats at a time (one per thread) into shared memory, then every
// pixel thread blends from shared memory. Out-of-image threads stay in the loop with
// done = true so every barrier stays in uniform control flow; a shared counter votes
// the whole tile out early once all pixels saturate.

#define TILE_WIDTH 16
#define TILE_HEIGHT 16

layout (local_size_x = TILE_WIDTH, local_size_y = TILE_HEIGHT, local_size_z = 1) in;

layout (std140, binding = 0) uniform FrameParams {
    mat4 view_3dgs;
    mat4 viewproj;
    vec4 cam_pos_model;
    vec4 bg_color;
    uvec2 resolution;
    uvec2 tile_grid;
    uint tile_bits;
    uint num_gaussians;
    uint sh_degree;
    float scale_modifier;
    float tan_fovx;
    float tan_fovy;
    float focal_x;
    float focal_y;
};

struct render_attr {
    vec4 conic_opacity;
    vec4 uv_color;
};

layout (std430, binding = 1) readonly buffer RenderAttrs {
    render_attr render_attrs[];
};

layout (std430, binding = 2) readonly buffer Boundaries {
    uint boundaries[];
};

layout (std430, binding = 3) readonly buffer SortedPayloads {
    uint sorted_payloads[];
};

layout (rgba8, binding = 4) uniform writeonly image2D output_image;

shared vec4 sh_conic_opacity[256];
shared vec4 sh_uv_color[256];
shared uint sh_done_count;

void main() {
    uint lid = gl_LocalInvocationIndex;
    uvec2 pixel = uvec2(gl_WorkGroupID.x * TILE_WIDTH + gl_LocalInvocationID.x,
                        gl_WorkGroupID.y * TILE_HEIGHT + gl_LocalInvocationID.y);
    bool inside = pixel.x < resolution.x && pixel.y < resolution.y;
    bool done = !inside;

    uint tile_id = gl_WorkGroupID.x + gl_WorkGroupID.y * tile_grid.x;
    uint range_start = boundaries[tile_id * 2u];
    uint range_end = boundaries[tile_id * 2u + 1u];

    vec2 pixf = vec2(pixel);
    float T = 1.0;
    vec3 color = vec3(0.0);

    for (uint start = range_start; start < range_end; start += 256u) {
        if (lid == 0u) sh_done_count = 0u;
        barrier();
        if (done) atomicAdd(sh_done_count, 1u);

        uint j = start + lid;
        if (j < range_end) {
            uint v = sorted_payloads[j];
            sh_conic_opacity[lid] = render_attrs[v].conic_opacity;
            sh_uv_color[lid] = render_attrs[v].uv_color;
        }
        barrier();
        if (sh_done_count == 256u) break;

        uint batch_count = min(256u, range_end - start);
        if (!done) {
            for (uint k = 0u; k < batch_count; ++k) {
                vec4 co = sh_conic_opacity[k];
                vec2 d = sh_uv_color[k].xy - pixf;
                float power = -0.5 * (co.x * d.x * d.x + co.z * d.y * d.y) - co.y * d.x * d.y;
                if (power > 0.0) continue;

                float alpha = min(0.99, co.w * exp(power));
                if (alpha < (1.0 / 255.0)) continue;

                float test_T = T * (1.0 - alpha);
                if (test_T < 0.0001) { done = true; break; } // saturating splat is excluded, like the reference

                vec3 c = vec3(unpackHalf2x16(floatBitsToUint(sh_uv_color[k].z)),
                              unpackHalf2x16(floatBitsToUint(sh_uv_color[k].w)).x);
                color += c * alpha * T;
                T = test_T;
            }
        }
        barrier(); // processing finished before the next batch overwrites shared memory
    }

    if (inside) {
        imageStore(output_image, ivec2(pixel), vec4(color + T * bg_color.rgb, 1.0));
    }
}
