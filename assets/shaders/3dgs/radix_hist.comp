#version 450 core

// Stable LSD radix sort, stage 1 of 3: per-workgroup digit histogram.
// Digit-major output layout (histogram[digit * num_wgs + wg]) so that one exclusive
// scan of the flat table yields the global stable base offset for every (digit, wg).
// Every active workgroup writes all 256 of its cells, so the table never needs clearing.

#define BLOCKS_PER_WG 32u

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (std430, binding = 0) readonly buffer GpuState {
    uint total_unclamped;
    uint num_instances;
    uint num_wgs_sort;
    uint instance_capacity;
};

layout (std430, binding = 1) readonly buffer KeysIn {
    uint keys_in[];
};

layout (std430, binding = 2) writeonly buffer Histogram {
    uint histogram[];
};

uniform uint u_shift;

shared uint sh_hist[256];

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg = gl_WorkGroupID.x;

    sh_hist[lid] = 0u;
    barrier();

    for (uint b = 0u; b < BLOCKS_PER_WG; ++b) {
        uint i = wg * BLOCKS_PER_WG * 256u + b * 256u + lid;
        if (i < num_instances) {
            uint d = (keys_in[i] >> u_shift) & 255u;
            atomicAdd(sh_hist[d], 1u);
        }
    }

    barrier();
    histogram[lid * num_wgs_sort + wg] = sh_hist[lid];
}
