#version 450 core

// Per-gaussian preprocess: cull, project, EWA covariance projection, spherical harmonics
// evaluation, and tight tile-extent computation. View convention is INRIA/COLMAP-style
// +z forward (the CPU premultiplies the GL right-handed view with diag(1,1,-1)), while
// clip positions use the untouched GL projection chain, so NDC x/y and the covariance
// share the same screen orientation.

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (std140, binding = 0) uniform FrameParams {
    mat4 view_3dgs;
    mat4 viewproj;
    vec4 cam_pos_model;
    vec4 bg_color;
    uvec2 resolution;
    uvec2 tile_grid;
    uint tile_bits;
    uint num_gaussians;
    uint sh_degree;
    float scale_modifier;
    float tan_fovx;
    float tan_fovy;
    float focal_x;
    float focal_y;
};

layout (std430, binding = 1) readonly buffer PosOpacity {
    vec4 pos_opacity[]; // xyz position, w = post-sigmoid opacity
};

layout (std430, binding = 2) readonly buffer Cov3Ds {
    float cov3ds[];
};

layout (std430, binding = 3) readonly buffer ShCoeffs {
    uint sh_coeffs[]; // 48 half floats (16 coeffs x rgb) packed into 24 uints per gaussian
};

layout (std430, binding = 4) writeonly buffer TileCounts {
    uint tile_counts[];
};

struct render_attr {
    vec4 conic_opacity;
    vec4 uv_color; // uv.xy, packHalf2x16(color.rg), packHalf2x16(color.b, 0)
};

layout (std430, binding = 5) writeonly buffer RenderAttrs {
    render_attr render_attrs[];
};

layout (std430, binding = 6) writeonly buffer EmitAttrs {
    uvec4 emit_attrs[]; // aabb min (y16|x16), aabb max (y16|x16), float bits of depth, unused
};

const float SH_C0 = 0.28209479177387814;
const float SH_C1 = 0.4886025119029199;
const float SH_C2[5] = float[5](
    1.0925484305920792,
    -1.0925484305920792,
    0.31539156525252005,
    -1.0925484305920792,
    0.5462742152960396
);
const float SH_C3[7] = float[7](
    -0.5900435899266435,
    2.890611442640554,
    -0.4570457994644658,
    0.3731763325901154,
    -0.4570457994644658,
    1.445305721320277,
    -0.5900435899266435
);

float fetch_sh(uint gaussian, uint flat_index) {
    uint word = sh_coeffs[gaussian * 24u + (flat_index >> 1u)];
    vec2 pair = unpackHalf2x16(word);
    return (flat_index & 1u) == 0u ? pair.x : pair.y;
}

vec3 fetch_sh_vec3(uint gaussian, uint coeff) {
    uint base = coeff * 3u;
    return vec3(fetch_sh(gaussian, base), fetch_sh(gaussian, base + 1u), fetch_sh(gaussian, base + 2u));
}

vec3 compute_sh(uint i, vec3 position) {
    vec3 dir = normalize(position - cam_pos_model.xyz);
    float x = dir.x;
    float y = dir.y;
    float z = dir.z;

    vec3 c = SH_C0 * fetch_sh_vec3(i, 0u);

    if (sh_degree >= 1u) {
        c -= SH_C1 * fetch_sh_vec3(i, 1u) * y;
        c += SH_C1 * fetch_sh_vec3(i, 2u) * z;
        c -= SH_C1 * fetch_sh_vec3(i, 3u) * x;
    }

    if (sh_degree >= 2u) {
        float xx = x * x, yy = y * y, zz = z * z;
        float xy = x * y, yz = y * z, xz = x * z;
        c += SH_C2[0] * fetch_sh_vec3(i, 4u) * xy;
        c += SH_C2[1] * fetch_sh_vec3(i, 5u) * yz;
        c += SH_C2[2] * fetch_sh_vec3(i, 6u) * (2.0 * zz - xx - yy);
        c += SH_C2[3] * fetch_sh_vec3(i, 7u) * xz;
        c += SH_C2[4] * fetch_sh_vec3(i, 8u) * (xx - yy);

        if (sh_degree >= 3u) {
            c += SH_C3[0] * fetch_sh_vec3(i, 9u) * y * (3.0 * xx - yy);
            c += SH_C3[1] * fetch_sh_vec3(i, 10u) * xy * z;
            c += SH_C3[2] * fetch_sh_vec3(i, 11u) * y * (4.0 * zz - xx - yy);
            c += SH_C3[3] * fetch_sh_vec3(i, 12u) * z * (2.0 * zz - 3.0 * xx - 3.0 * yy);
            c += SH_C3[4] * fetch_sh_vec3(i, 13u) * x * (4.0 * zz - xx - yy);
            c += SH_C3[5] * fetch_sh_vec3(i, 14u) * z * (xx - yy);
            c += SH_C3[6] * fetch_sh_vec3(i, 15u) * x * (xx - 3.0 * yy);
        }
    }

    c += 0.5;
    return max(c, vec3(0.0));
}

float ndc2pix(float v, uint s) {
    return ((v + 1.0) * float(s) - 1.0) * 0.5;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= num_gaussians) return;

    tile_counts[i] = 0u;

    vec4 po = pos_opacity[i];
    float opacity = po.w;
    if (opacity < (1.0 / 255.0)) return; // can never pass the render loop's alpha cutoff

    vec4 p_view = view_3dgs * vec4(po.xyz, 1.0);
    if (p_view.z <= 0.2) return;

    vec4 p_hom = viewproj * vec4(po.xyz, 1.0);
    float inv_w = 1.0 / (p_hom.w + 0.0001);
    vec2 ndc = p_hom.xy * inv_w;

    // EWA projection: Sigma' = J W Sigma W^T J^T (J and W stored transposed, the algebra
    // self-cancels through cov = T^T Sigma T -- matches the INRIA reference exactly).
    vec3 t = p_view.xyz;
    float limx = 1.3 * tan_fovx;
    float limy = 1.3 * tan_fovy;
    t.x = clamp(t.x / t.z, -limx, limx) * t.z;
    t.y = clamp(t.y / t.z, -limy, limy) * t.z;

    mat3 J = mat3(
        focal_x / t.z, 0.0, -(focal_x * t.x) / (t.z * t.z),
        0.0, focal_y / t.z, -(focal_y * t.y) / (t.z * t.z),
        0.0, 0.0, 0.0);
    mat3 W = transpose(mat3(view_3dgs));
    mat3 Sigma = mat3(
        cov3ds[i * 6u + 0u], cov3ds[i * 6u + 1u], cov3ds[i * 6u + 2u],
        cov3ds[i * 6u + 1u], cov3ds[i * 6u + 3u], cov3ds[i * 6u + 4u],
        cov3ds[i * 6u + 2u], cov3ds[i * 6u + 4u], cov3ds[i * 6u + 5u]);
    mat3 T = W * J;
    mat3 cov_full = transpose(T) * Sigma * T;

    // Low-pass dilation: every splat is at least ~half a pixel wide
    vec3 cov2d = vec3(cov_full[0][0] + 0.3, cov_full[0][1], cov_full[1][1] + 0.3);
    float det = cov2d.x * cov2d.z - cov2d.y * cov2d.y;
    if (!(det > 0.0)) return; // written this way to also reject NaN covariance

    float det_inv = 1.0 / det;
    vec3 conic = vec3(cov2d.z * det_inv, -cov2d.y * det_inv, cov2d.x * det_inv);

    // Opacity-aware extent: largest Mahalanobis distance that can still contribute
    // alpha >= 1/255, capped at the full footprint sqrt(2 ln 255) ~= 3.33 sigma.
    // Per-axis ellipse AABB half-extents are extend * sqrt(diagonal of the covariance).
    float extend = min(3.33, sqrt(max(0.0, 2.0 * log(255.0 * opacity))));
    vec2 uv = vec2(ndc2pix(ndc.x, resolution.x), ndc2pix(ndc.y, resolution.y));
    vec2 ext = vec2(extend * sqrt(cov2d.x), extend * sqrt(cov2d.z));

    ivec2 tmin = ivec2(
        clamp(int((uv.x - ext.x) / 16.0), 0, int(tile_grid.x)),
        clamp(int((uv.y - ext.y) / 16.0), 0, int(tile_grid.y)));
    ivec2 tmax = ivec2(
        clamp(int((uv.x + ext.x + 15.0) / 16.0), 0, int(tile_grid.x)),
        clamp(int((uv.y + ext.y + 15.0) / 16.0), 0, int(tile_grid.y)));

    uint overlap = uint(max(tmax.x - tmin.x, 0)) * uint(max(tmax.y - tmin.y, 0));
    if (overlap == 0u) return;

    vec3 color = compute_sh(i, po.xyz);

    tile_counts[i] = overlap;
    render_attrs[i].conic_opacity = vec4(conic, opacity);
    render_attrs[i].uv_color = vec4(uv, uintBitsToFloat(packHalf2x16(color.rg)), uintBitsToFloat(packHalf2x16(vec2(color.b, 0.0))));
    emit_attrs[i] = uvec4(uint(tmin.x) | (uint(tmin.y) << 16), uint(tmax.x) | (uint(tmax.y) << 16), floatBitsToUint(p_view.z), 0u);
}
