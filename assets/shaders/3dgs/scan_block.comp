#version 450 core

// Hierarchical exclusive scan, pass A: each workgroup scans a 2048-element block
// (256 threads x 8 items) and emits its block total for pass B.

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (std430, binding = 0) readonly buffer ScanLength {
    uint scan_length;
};

layout (std430, binding = 1) readonly buffer InputData {
    uint in_data[];
};

layout (std430, binding = 2) writeonly buffer OutputData {
    uint out_data[];
};

layout (std430, binding = 3) writeonly buffer BlockSums {
    uint block_sums[];
};

shared uint sh[256];

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint base = gl_WorkGroupID.x * 2048u + lid * 8u;

    uint v[8];
    uint thread_total = 0u;
    for (uint j = 0u; j < 8u; ++j) {
        v[j] = (base + j < scan_length) ? in_data[base + j] : 0u;
        thread_total += v[j];
    }

    // Inclusive Hillis-Steele scan of per-thread totals across the workgroup
    sh[lid] = thread_total;
    barrier();
    for (uint s = 1u; s < 256u; s <<= 1u) {
        uint t = (lid >= s) ? sh[lid - s] : 0u;
        barrier();
        sh[lid] += t;
        barrier();
    }
    uint thread_exclusive = sh[lid] - thread_total;

    uint prefix = 0u;
    for (uint j = 0u; j < 8u; ++j) {
        if (base + j < scan_length) out_data[base + j] = thread_exclusive + prefix;
        prefix += v[j];
    }

    if (lid == 255u) block_sums[gl_WorkGroupID.x] = sh[255];
}
